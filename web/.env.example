NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-20
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server-only. Viewer token used for Draft Mode / Presentation previews.
SANITY_API_READ_TOKEN=

# Address the navbar "Contact me" button opens. Leave blank to disable the link.
NEXT_PUBLIC_CONTACT_EMAIL=

# Profile links opened from the "About me" section. Leave blank to hide an icon.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Shown on the business card in the home page contact callout.
# Leave either blank to hide that line.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SITE_URL=

# Shared secret for the Sanity publish webhook that hits /api/revalidate.
# Must match the secret configured on the webhook in sanity.io/manage.
SANITY_REVALIDATE_SECRET=
